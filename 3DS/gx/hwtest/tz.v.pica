; GPU self-test shader (gx_init.c gx_hwtest, S3D_GPU_SELFTEST, bug 12).
; Inputs follow GxOutVertex: v0 pos, v1 color (u8), v2 matrix index (u8),
; v3-v5 texcoords, v6 normal (s16).
.constf myconst(0.0, 1.0, 0.00392156862745, 0.0)
.alias  zeros  myconst.xxxx
.alias  ones   myconst.yyyy
.alias  inv255 myconst.zzzz
; tz: an exact copy of t2, at the end of hwtest.shbin (file names sort
; digits first). t2 at code word 18 passes on hardware, t3/t4 at 31/47 hang:
; this tells whether the code position matters or the instructions do
.fvec projection[4]
.fvec posmtx[30]
.out outpos position
.out outclr color
.entry tz
.proc tz
	mova a0.x, v2.x
	mov r0.xyz, v0
	mov r0.w, ones
	dp4 r1.x, posmtx[a0.x], r0
	dp4 r1.y, posmtx[a0.x+1], r0
	dp4 r1.z, posmtx[a0.x+2], r0
	mov r1.w, ones
	dp4 outpos.x, projection[0], r1
	dp4 outpos.y, projection[1], r1
	dp4 outpos.z, projection[2], r1
	dp4 outpos.w, projection[3], r1
	mul outclr, inv255, v1
	end
.end
