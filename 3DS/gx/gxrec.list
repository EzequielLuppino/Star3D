# GX entry points recorded by the render-thread recorder (gx/gx_rec.c,
# MULTICORE_PLAN.md step 2). tools/gen_gxrec.py turns this list into the
# wrappers (-Wl,--wrap=<name>, Makefile GXREC_WRAPPED), the record encoders and
# the replay switch (build/<version>_3ds/gxrec_gen.c, gxrec_gen.h).
#
# One entry per line: <kind> <prototype exactly as defined in gx/ or port/>
#   cmd     Recorded into the FIFO; the render thread (S3D_RENDER_THREAD=2) or
#           the frame end (=1) calls the real function with the same arguments.
#   sync    Rare calls whose result depends on render-side state: the recorder
#           waits until the render thread has replayed everything, then calls
#           the real function on the game thread (counter rt.sync.<name>).
#   manual  The wrapper is written by hand in gx_rec.c (answers on the game
#           thread from recorder-side state); the generator only emits the
#           opcode, the encoder gxrec_put_<name>() and the replay case.
#   wrap    Hand-written wrapper with no command of its own (only --wrap).
#
# Arguments: numbers, enums and bools are stored as one word, floats as their
# bits, GXColor / GXColorS10 by value. Pointers are stored as pointers, and the
# data behind them is read at replay time, like the GameCube GPU reads display
# lists, vertex arrays and textures late. "@<bytes>" after a pointer argument's
# name copies that many bytes at record time instead (matrices, texture and
# light objects, which the game reuses right after the call, as the real GX
# copies them into its FIFO); "@{expr}" computes the size from the other
# arguments.
#
# Not listed, so never recorded: functions that touch neither the GX state
# (g_gx) nor citro3d: GXInitTexObj*, GXGetTexObj*, GXInitLight*,
# GXGetLightAttnK, GXGetTexBufferSize, the FIFO / copy-filter / pixel-format
# no-ops, the draw-sync and breakpoint shims (foxhollow gx_shim.c, game thread
# only), and the port hooks that only read settings (port_fur_*, port_shadows_*,
# port_stereo_focus: read at the frame start,
# port_blend_textures: game memory only). GXPeekZ is not listed either: it
# reads finished depth copies of earlier frames under a lock (gx_copy.c), so
# the frame-end breakpoint callback calls it directly without a drain.

# --- Vertex format and arrays ---
cmd void GXSetVtxAttrFmt(GXVtxFmt vtxfmt, GXAttr attr, GXCompCnt cnt, GXCompType type, u8 frac)
# manual: the recorder also keeps their values (gx_rec.c), to know which
# arrays a display list call can read when it hashes them
manual void GXSetVtxDesc(GXAttr attr, GXAttrType type)
manual void GXClearVtxDesc(void)
manual void GXSetArray(GXAttr attr, const void* data, u32 size, u8 stride, bool le)

# --- Transform ---
cmd void GXLoadPosMtxImm(const void* mtx@48, u32 id)
# manual: S3D_RT_DEDUP bit 2 skips it (nothing reads normal matrices, gx_rec.c)
manual void GXLoadNrmMtxImm(const void* mtx@48, u32 id)
cmd void GXLoadTexMtxImm(const void* mtx@{(id >= GX_PTTEXMTX0 || type != GX_MTX2x4) ? 48 : 32}, u32 id, GXTexMtxType type)
cmd void GXSetCurrentMtx(u32 id)
cmd void GXSetProjection(const void* mtx@48, GXProjectionType type)
cmd void GXSetViewport(f32 left, f32 top, f32 wd, f32 ht, f32 nearz, f32 farz)
cmd void GXSetViewportJitter(f32 left, f32 top, f32 wd, f32 ht, f32 nearz, f32 farz, u32 field)
manual void GXSetScissor(u32 left, u32 top, u32 wd, u32 ht)
wrap void GXGetScissor(u32* left, u32* top, u32* wd, u32* ht)

# --- Texture coordinates and lighting ---
cmd void GXSetNumTexGens(u8 nTexGens)
cmd void GXSetTexCoordGen2(GXTexCoordID dst_coord, GXTexGenType func, GXTexGenSrc src_param, u32 mtx, GXBool normalize, u32 postmtx)
cmd void GXSetNumChans(u8 nChans)
cmd void GXSetChanCtrl(GXChannelID chan, GXBool enable, GXColorSrc amb_src, GXColorSrc mat_src, u32 light_mask, GXDiffuseFn diff_fn, GXAttnFn attn_fn)
cmd void GXSetChanAmbColor(GXChannelID chan, GXColor amb_color)
cmd void GXSetChanMatColor(GXChannelID chan, GXColor mat_color)
cmd void GXLoadLightObjImm(GXLightObj* lt_obj@{sizeof(GXLightObj)}, GXLightID light)

# --- Pixel pipeline ---
cmd void GXSetBlendMode(GXBlendMode type, GXBlendFactor src_factor, GXBlendFactor dst_factor, GXLogicOp op)
cmd void GXSetZMode(GXBool compare_enable, GXCompare func, GXBool update_enable)
cmd void GXSetColorUpdate(GXBool update_enable)
cmd void GXSetAlphaUpdate(GXBool update_enable)
cmd void GXSetCullMode(GXCullMode mode)
cmd void GXSetAlphaCompare(GXCompare comp0, u8 ref0, GXAlphaOp op, GXCompare comp1, u8 ref1)
cmd void GXSetFog(GXFogType type, f32 startz, f32 endz, f32 nearz, f32 farz, GXColor color)
cmd void GXSetCopyClear(GXColor clear_clr, u32 clear_z)
cmd void GXEnableTexOffsets(GXTexCoordID coord, GXBool line_enable, GXBool point_enable)
cmd void GXSetLineWidth(u8 width, GXTexOffset texOffsets)
cmd void GXSetPointSize(u8 pointSize, GXTexOffset texOffsets)

# --- TEV and indirect stages ---
cmd void GXSetNumTevStages(u8 nStages)
cmd void GXSetTevOrder(GXTevStageID stage, GXTexCoordID coord, GXTexMapID map, GXChannelID color)
cmd void GXSetTevColorIn(GXTevStageID stage, GXTevColorArg a, GXTevColorArg b, GXTevColorArg c, GXTevColorArg d)
cmd void GXSetTevAlphaIn(GXTevStageID stage, GXTevAlphaArg a, GXTevAlphaArg b, GXTevAlphaArg c, GXTevAlphaArg d)
cmd void GXSetTevColorOp(GXTevStageID stage, GXTevOp op, GXTevBias bias, GXTevScale scale, GXBool clamp, GXTevRegID out_reg)
cmd void GXSetTevAlphaOp(GXTevStageID stage, GXTevOp op, GXTevBias bias, GXTevScale scale, GXBool clamp, GXTevRegID out_reg)
cmd void GXSetTevColor(GXTevRegID id, GXColor color)
cmd void GXSetTevColorS10(GXTevRegID id, GXColorS10 color)
cmd void GXSetTevKColor(GXTevKColorID id, GXColor color)
cmd void GXSetTevKColorSel(GXTevStageID stage, GXTevKColorSel sel)
cmd void GXSetTevKAlphaSel(GXTevStageID stage, GXTevKAlphaSel sel)
cmd void GXSetTevOp(GXTevStageID id, GXTevMode mode)
cmd void GXSetTevSwapMode(GXTevStageID stage, GXTevSwapSel ras_sel, GXTevSwapSel tex_sel)
cmd void GXSetTevSwapModeTable(GXTevSwapSel table, GXTevColorChan red, GXTevColorChan green, GXTevColorChan blue, GXTevColorChan alpha)
cmd void GXSetIndTexOrder(GXIndTexStageID ind_stage, GXTexCoordID tex_coord, GXTexMapID tex_map)
cmd void GXSetNumIndStages(u8 nIndStages)
cmd void GXSetTevDirect(GXTevStageID tev_stage)
cmd void GXSetTevIndirect(GXTevStageID tev_stage, GXIndTexStageID ind_stage, GXIndTexFormat format, GXIndTexBiasSel bias_sel, GXIndTexMtxID matrix_sel, GXIndTexWrap wrap_s, GXIndTexWrap wrap_t, GXBool add_prev, GXBool ind_lod, GXIndTexAlphaSel alpha_sel)
# func is a string literal (the patched call site's name)
cmd void port_tev_indirect(const char* func, GXTevStageID tev_stage, GXIndTexStageID ind_stage, GXIndTexFormat format, GXIndTexBiasSel bias_sel, GXIndTexMtxID matrix_sel, GXIndTexWrap wrap_s, GXIndTexWrap wrap_t, GXBool add_prev, GXBool ind_lod, GXIndTexAlphaSel alpha_sel)

# --- Textures and copies ---
cmd void GXLoadTexObj(GXTexObj* obj@{sizeof(GXTexObj)}, GXTexMapID id)
cmd void GXInvalidateTexAll(void)
cmd void port_tex_want_mips(const void* data)
cmd void GXSetTexCopySrc(u16 left, u16 top, u16 wd, u16 ht)
cmd void GXSetTexCopyDst(u16 wd, u16 ht, GXTexFmt fmt, GXBool mipmap)
cmd void GXCopyTex(void* dest, GXBool clear)
cmd void GXCopyDisp(void* dest, GXBool clear)
cmd void GXFlush(void)
# Copy lookups (gx_copytex_find) are render-side: answered after a drain
sync bool port_copytex_blur(const void* dest, int window)
# Called every frame for the reflection: after one answer of true, the same
# arguments answer true on the game thread (gx_rec.c)
manual bool port_copytex_mip_alias(const void* dest, const void* src, int w)
manual bool port_copytex_blur_scope(const void* dest, int level)

# --- Drawing ---
manual void GXCallDisplayList(const void* list, u32 nbytes)
# What a recorded GXCallDisplayList becomes: the call plus the display list
# cache's game-memory hashes, computed on the game thread at record time
# (hashes[0] = list hash, then one keyed array hash per bit of mask, gx_dlcache.c)
manual void gx_dl_call_hashed(const void* list, u32 nbytes, u32 mask, const u32* hashes@{(1 + __builtin_popcount(mask)) * 4})
manual void GXBegin(GXPrimitive type, GXVtxFmt vtxfmt, u16 nverts)
manual void GXEnd(void)
# Immediate-mode vertex data: bytes appended to the GXBegin command's data
# (or to the display list being recorded)
wrap void GXPosition3f32(f32 x, f32 y, f32 z)
wrap void GXPosition3u16(u16 x, u16 y, u16 z)
wrap void GXPosition3s16(s16 x, s16 y, s16 z)
wrap void GXPosition3u8(u8 x, u8 y, u8 z)
wrap void GXPosition3s8(s8 x, s8 y, s8 z)
wrap void GXPosition2f32(f32 x, f32 y)
wrap void GXPosition2u16(u16 x, u16 y)
wrap void GXPosition2s16(s16 x, s16 y)
wrap void GXPosition2u8(u8 x, u8 y)
wrap void GXPosition2s8(s8 x, s8 y)
wrap void GXPosition1x16(u16 index)
wrap void GXPosition1x8(u8 index)
wrap void GXNormal3f32(f32 x, f32 y, f32 z)
wrap void GXNormal3s16(s16 x, s16 y, s16 z)
wrap void GXNormal3s8(s8 x, s8 y, s8 z)
wrap void GXNormal1x16(u16 index)
wrap void GXNormal1x8(u8 index)
wrap void GXColor4u8(u8 r, u8 g, u8 b, u8 a)
wrap void GXColor3u8(u8 r, u8 g, u8 b)
wrap void GXColor1u32(u32 clr)
wrap void GXColor1u16(u16 clr)
wrap void GXColor1x16(u16 index)
wrap void GXColor1x8(u8 index)
wrap void GXTexCoord2f32(f32 s, f32 t)
wrap void GXTexCoord2u16(u16 s, u16 t)
wrap void GXTexCoord2s16(s16 s, s16 t)
wrap void GXTexCoord2u8(u8 s, u8 t)
wrap void GXTexCoord2s8(s8 s, s8 t)
wrap void GXTexCoord1f32(f32 s)
wrap void GXTexCoord1u16(u16 s)
wrap void GXTexCoord1s16(s16 s)
wrap void GXTexCoord1u8(u8 s)
wrap void GXTexCoord1s8(s8 s)
wrap void GXTexCoord1x16(u16 index)
wrap void GXTexCoord1x8(u8 index)
# Display lists are recorded on the game thread (the game reads the size back)
wrap void GXBeginDisplayList(void* list, u32 size)
wrap u32 GXEndDisplayList(void)

# --- Port render passes (answered on the game thread, gx_rec.c) ---
manual bool gx_hud_begin(void)
manual void gx_hud_end(void)
cmd void gx_hud_set_map(float src_x, float src_y, float scale, float dst_x, float dst_y)
manual bool gx_offscreen_begin(float x, float y, float w, float h, int res)
manual void gx_offscreen_end(void)
cmd void gx_draw_discard(bool on)
# Fur / grass budgets and "3D: reduced" (game thread): stereo unless a HUD or
# offscreen pass is open, which the render thread toggles; answered from the
# frame's stereo flag and the recorder's pass tracking
wrap bool port_stereo_active(void)
wrap bool port_stereo_reduced(void)

# --- Init ---
sync GXFifoObj* GXInit(void* base, u32 size)
