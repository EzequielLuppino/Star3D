; Vertex bench (gx_init.c gx_vbench): 3 inputs (position, color, texcoord0)
; and the game's 7 outputs. The bench loads them from the 52-byte GxOutVertex
; stride (other attributes skipped with padding) and from a compact 24-byte
; layout: isolates the input attribute count and the bytes fetched.

.constf consts(0.0, 1.0, 0.00392156862745, 0.0)
.alias zeros consts.xxxx
.alias ones  consts.yyyy

.out outpos position
.out outclr color
.out outtc0 texcoord0
.out outtc1 texcoord1
.out outtc2 texcoord2
.out outview view
.out outnq normalquat

.entry main_in3
.proc main_in3
	mov r0, v0
	mov r0.w, ones
	mov outpos, r0
	mul outclr, consts.zzzz, v1
	mov outtc0, v2
	mov outtc1, v2
	mov outtc2, v2
	mov outview, r0
	mov outnq, consts.xxxy
	end
.end
