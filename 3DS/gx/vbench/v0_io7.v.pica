; Vertex bench (gx_init.c gx_vbench): the game's inputs and outputs with
; almost no ALU work. Reads all 7 GxOutVertex attributes (52 B) and writes the
; game shaders' 7 outputs, each once and in full (bugs 12 and 14). Positions
; are already in clip space. Compared with the unlit shader (same I/O, ~57
; instructions) this isolates the instruction cost.

.constf consts(0.0, 1.0, 0.00392156862745, 0.0)
.alias zeros consts.xxxx
.alias ones  consts.yyyy

.out outpos position
.out outclr color
.out outtc0 texcoord0
.out outtc1 texcoord1
.out outtc2 texcoord2
.out outview view
.out outnq normalquat

.entry main_io7
.proc main_io7
	mov r0, v0
	mov r0.w, ones
	mov outpos, r0
	mul outclr, consts.zzzz, v1
	mov outtc0, v3
	mov outtc1, v4
	mov outtc2, v5
	mul outview, consts.zzzz, v6
	mul outnq, consts.zzzz, v2
	end
.end
