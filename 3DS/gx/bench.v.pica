; Benchmark shader (os/bench.c): positions are already in clip space.
; v0 = position (xyz), v1 = color (0-255), v2 = texcoord
; Also outputs a fixed normal quaternion and view vector so fragment
; lighting can be timed.

.constf consts(0.0, 1.0, 0.00392156862745, 0.70710678)
.alias zeros consts.xxxx
.alias ones  consts.yyyy

.fvec posscale   ; x: scale applied to v0 (1 for float input, 1/32767 for s16)

.out outpos position
.out outclr color
.out outtc0 texcoord0
.out outtc1 texcoord1
.out outq   normalquat
.out outv   view

.proc main
	mul r0.xyz, posscale.xxx, v0
	mov r0.w, ones
	mov outpos, r0
	mul outclr, consts.zzzz, v1
	mov outtc0, v2
	mov outtc1, v2
	; Normal facing the viewer: quaternion (0, 0, 0, 1); view vector (0, 0, 1)
	mov r1, zeros
	mov r1.w, ones
	mov outq, r1
	mov r2, zeros
	mov r2.z, ones
	mov outv, r2
	end
.end
